    "axios": "^1.3.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "ip": "^1.1.8",
    "moment-timezone": "^0.5.43",
    "mysql": "^2.18.1",
    "qr-image": "^3.2.0",
    "rimraf": "^5.0.0",
    "socket.io": "^4.6.1",
    "spintax": "^0.0.1"
  }
