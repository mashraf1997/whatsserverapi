# Copy this file to .env and fill in real values. Never commit .env.

# HTTP server
PORT=8000
DEBUG=false

# MySQL database
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_CHARSET=utf8mb4
DB_CONNECTION_LIMIT=100
DB_DEBUG=false
# Leave off unless you truly need stacked statements (security risk).
DB_MULTIPLE_STATEMENTS=false

# CORS: set to your dashboard origin in production, e.g. https://app.example.com
CORS_ORIGIN=*
